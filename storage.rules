rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Tile files (PMTiles / GeoJSON): public read, no client writes
    match /tiles/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // User-uploaded photos: read is public (for global gallery), write only by authenticated owner
    match /photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
