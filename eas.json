{
  "cli": {
    "version": ">= 18.13.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    },
    "rollout_10": {
      "android": {
        "track": "production",
        "rollout": "0.1",
        "changesNotSentForReview": false
      }
    },
    "rollout_50": {
      "android": {
        "track": "production",
        "rollout": "0.5",
        "changesNotSentForReview": false
      }
    },
    "rollout_100": {
      "android": {
        "track": "production",
        "rollout": "1.0",
        "changesNotSentForReview": false
      }
    }
  }
}
